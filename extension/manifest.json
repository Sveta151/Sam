{
  "manifest_version": 3,
  "name": "PaperPilot: Save Paper",
  "version": "0.1.0",
  "description": "Save the current page as a paper into PaperPilot via deep-link.",
  "action": {
    "default_title": "Save to PaperPilot",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
